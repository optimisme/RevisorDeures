// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Practica {
  id          String       @id @default(cuid())
  nom         String
  descripcio  String?
  criteri     Criteri[]
  entrega     Entrega[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Criteri {
  id          String      @id @default(cuid())
  text        String
  posicio     Int
  practica    Practica    @relation(fields: [practicaId], references: [id])
  practicaId  String
  resultat    ResultatCriteri[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Entrega {
  id          String           @id @default(cuid())
  urlRepo     String
  estat       String           @default("PENDING")
  practica    Practica         @relation(fields: [practicaId], references: [id])
  practicaId  String
  resultats   ResultatCriteri[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ResultatCriteri {
  id           String   @id @default(cuid())
  status       String   @default("NEEDS_REVIEW")
  feedback     String?
  evidencia    String?
  estatTecnic  String?
  entrega      Entrega  @relation(fields: [entregaId], references: [id])
  entregaId    String
  criteri      Criteri  @relation(fields: [criteriId], references: [id])
  criteriId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
